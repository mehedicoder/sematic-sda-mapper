:RequiredCapability a owl:Class ;
    rdfs:comment "The capability facet a UseCaseRequirement demands. Distinct node from any OfferedCapability -- matching is now a real comparison (capabilityType equality, extensible to full attribute matching later), not shared identity."^^xsd:string ;
    rdfs:subClassOf :Capability ;
    owl:disjointWith :OfferedCapability .

:contextConstrainedBy a owl:ObjectProperty ;
    rdfs:label "contextConstrainedBy"^^xsd:string ;
    rdfs:comment "Used as: DeploymentContext → :SafetyClass"^^xsd:string ;
    rdfs:domain :DeploymentContext ;
    rdfs:range :SafetyClass ;
    owl:inverseOf :constrainsContext .

:hasConstraint a owl:ObjectProperty ;
    rdfs:label "hasConstraint"^^xsd:string ;
    rdfs:comment "Used as: UseCaseRequirement → :UseCaseRequirementConstraint"^^xsd:string ;
    rdfs:domain :UseCaseRequirement ;
    rdfs:range :UseCaseRequirementConstraint ;
    owl:inverseOf :constrains .

:OfferedCapability a owl:Class ;
    rdfs:comment "The capability facet a Skill actually provides. See RequiredCapability."^^xsd:string ;
    rdfs:subClassOf :Capability .

:Observation a owl:Class ;
    rdfs:label "Observation"^^xsd:string ;
    :classNumber "4.4"^^xsd:string ;
    :isa95Alignment "ISA-95 Level 1"^^xsd:string ;
    :ontologyLayer "Layer 4 — Physical Plant (Minimal)"^^xsd:string ;
    rdfs:comment "A timestamped measurement event — the atomic fact a diagnostics Skill (e.g. NE107 status) reads or writes."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:Sensor a owl:Class ;
    rdfs:label "Sensor"^^xsd:string ;
    :classNumber "4.2"^^xsd:string ;
    :isa95Alignment "ISA-95 Level 1"^^xsd:string ;
    :ontologyLayer "Layer 4 — Physical Plant (Minimal)"^^xsd:string ;
    rdfs:comment "A measurement device on an Asset producing Observations of a ProcessVariable."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:UseCaseRequirementConstraint a owl:Class ;
    rdfs:label "UseCaseRequirementConstraint"^^xsd:string ;
    :classNumber "1.5"^^xsd:string ;
    :isa95Alignment "ISA-95 Level 4"^^xsd:string ;
    :ontologyLayer "Layer 1 — Application & Requirements"^^xsd:string ;
    rdfs:comment "A boundary condition on a UseCaseRequirement, hard or soft — evaluated by the R0-HardConstraint pre-filter and R3's NOT EXISTS pattern. Renamed from 'RequirementConstraint' to match its owning class's new name."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:VerificationCriterion a owl:Class ;
    rdfs:label "VerificationCriterion"^^xsd:string ;
    :classNumber "1.6"^^xsd:string ;
    :isa95Alignment "ISA-95 Level 4"^^xsd:string ;
    :ontologyLayer "Layer 1 — Application & Requirements"^^xsd:string ;
    rdfs:comment "The test and threshold that confirms a UseCaseRequirement's satisfaction after deployment — the trigger condition R-Verify checks."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:SafetyClass a owl:Class ;
    rdfs:label "SafetyClass"^^xsd:string ;
    :classNumber "2b.5"^^xsd:string ;
    :isa95Alignment "No ISA-95 equivalent"^^xsd:string ;
    :ontologyLayer "Layer 2b — Platform Infrastructure (Margo-Aligned)"^^xsd:string ;
    rdfs:comment "A minimal safety/SIL classification carried by a DeploymentContext or DeploymentPolicy — enough to represent the SIL-2 fermentation-skid example without the full Langmann C0–C3 control-partitioning apparatus (deferred to the closed-loop control phase)."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:SkillParameter a owl:Class ;
    rdfs:label "SkillParameter"^^xsd:string ;
    :classNumber "2.3"^^xsd:string ;
    :isa95Alignment "ISA-95 Level 3"^^xsd:string ;
    :ontologyLayer "Layer 2 — Capability, Skill, Service"^^xsd:string ;
    rdfs:comment "A typed configuration parameter quantifying how a Skill executes — the lift target for MTP <Parameter> elements (Example A), or for a Margo Application Description's parameters/configuration block when the skill is exposed as a Margo-deployed service. Uses the same Margo Parameter/Schema vocabulary as UseCaseRequirementParameter, but under its own 'param'-prefixed property names (matching this class's existing paramID/paramName convention) so the two classes' properties never collide."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:Asset a owl:Class ;
    rdfs:label "Asset"^^xsd:string ;
    :classNumber "4.1"^^xsd:string ;
    :isa95Alignment "ISA-95 Level 1"^^xsd:string ;
    :ontologyLayer "Layer 4 — Physical Plant (Minimal)"^^xsd:string ;
    rdfs:comment "A physical or logical plant entity that is the subject of a Capability's operatesOn — the ground-truth anchor for the flowmeter, fermentation-skid, and HVAC examples."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:UseCase a owl:Class ;
    rdfs:label "UseCase"^^xsd:string ;
    :classNumber "1.2"^^xsd:string ;
    :isa95Alignment "ISA-95 Level 4"^^xsd:string ;
    :ontologyLayer "Layer 1 — Application & Requirements"^^xsd:string ;
    rdfs:comment "Defines a named business scenario whose UseCaseRequirements drive Capability/Skill/Service matching. Requirements attach directly here — no intermediate RequirementSet."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:ProcessVariable a owl:Class ;
    rdfs:label "ProcessVariable"^^xsd:string ;
    :classNumber "4.3"^^xsd:string ;
    :isa95Alignment "ISA-95 Level 1"^^xsd:string ;
    :ontologyLayer "Layer 4 — Physical Plant (Minimal)"^^xsd:string ;
    rdfs:comment "A named, typed, unit-annotated physical quantity — annotated by SemanticConcept, measured by Sensor."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:SemanticConcept a owl:Class ;
    rdfs:label "SemanticConcept"^^xsd:string ;
    :classNumber "3.2"^^xsd:string ;
    :isa95Alignment "ISA-95 Level 2"^^xsd:string ;
    :ontologyLayer "Layer 3 — Information & Connectivity"^^xsd:string ;
    rdfs:comment "A named concept (IEC CDD IRI) a Skill declares via requiresConcept — R2a's NOT EXISTS check confirms a matching instance exists."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:ServiceInstance a owl:Class ;
    rdfs:label "ServiceInstance"^^xsd:string ;
    :classNumber "2.5"^^xsd:string ;
    :isa95Alignment "ISA-95 Level 3"^^xsd:string ;
    :ontologyLayer "Layer 2 — Capability, Skill, Service"^^xsd:string ;
    rdfs:comment "A running container instance of a Service. deployStatus is the write-back target once R-Deploy commits a match."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:Stakeholder a owl:Class ;
    rdfs:label "Stakeholder"^^xsd:string ;
    :classNumber "1.1"^^xsd:string ;
    :isa95Alignment "ISA-95 Level 4"^^xsd:string ;
    :ontologyLayer "Layer 1 — Application & Requirements"^^xsd:string ;
    rdfs:comment "Represents the person, role, or organization that owns a UseCaseRequirement and initiates a UseCase. Simplified from the full role taxonomy — captures identity and authority only."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:CommunicationBinding a owl:Class ;
    rdfs:label "CommunicationBinding"^^xsd:string ;
    :classNumber "3.3"^^xsd:string ;
    :isa95Alignment "ISA-95 Level 2"^^xsd:string ;
    :ontologyLayer "Layer 3 — Information & Connectivity"^^xsd:string ;
    rdfs:comment "Protocol/transport descriptor bound to a Skill/Service — R2b's protocol-match check against the asset's host server."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:UseCaseRequirementParameter a owl:Class ;
    rdfs:label "UseCaseRequirementParameter"^^xsd:string ;
    :classNumber "1.4"^^xsd:string ;
    :isa95Alignment "ISA-95 Level 4"^^xsd:string ;
    :ontologyLayer "Layer 1 — Application & Requirements"^^xsd:string ;
    rdfs:comment "A measurable, typed, unit-annotated attribute quantifying a UseCaseRequirement — read directly by R3's SPARQL FILTER clauses (e.g. recall ≥ 0.90, latency ≤ 60). dataType and the validation attributes below restate Margo's own Parameter/Schema vocabulary (Application Description spec) rather than inventing a separate one, so a parameter lifted from a UseCaseRequirement and one lifted from a Margo margo.yaml Parameter/Schema block are typed identically. Renamed from 'RequirementParameter' to match its owning class's new name."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:Capability a owl:Class ;
    rdfs:label "Capability"^^xsd:string ;
    :classNumber "2.1"^^xsd:string ;
    :isa95Alignment "ISA-95 Level 3"^^xsd:string ;
    :ontologyLayer "Layer 2 — Capability, Skill, Service"^^xsd:string ;
    rdfs:comment "A named functional intent mapped from a UseCaseRequirement. R1 hop 1→2 (mapsToCapability → realisedBy)."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:InformationModel a owl:Class ;
    rdfs:label "InformationModel"^^xsd:string ;
    :classNumber "3.1"^^xsd:string ;
    :isa95Alignment "ISA-95 Level 2"^^xsd:string ;
    :ontologyLayer "Layer 3 — Information & Connectivity"^^xsd:string ;
    rdfs:comment "A semantic model describing device or process semantics (AAS submodel, PA-DIM namespace, MTP companion spec) — what R2a's concept-coverage check validates against."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:NetworkZone a owl:Class ;
    rdfs:label "NetworkZone"^^xsd:string ;
    :classNumber "2b.4"^^xsd:string ;
    :isa95Alignment "No ISA-95 equivalent"^^xsd:string ;
    :ontologyLayer "Layer 2b — Platform Infrastructure (Margo-Aligned)"^^xsd:string ;
    rdfs:comment "A network segment (OT, DMZ, IT, Cloud, Edge) with its own latency and security profile — tags where a ClusterNode/DeploymentContext sits. Full latency-budget reasoning (matching a ControlCapability's maxLatencyMs against this zone) is deferred until the closed-loop control classes are in scope — kept here as a simple tagging class only."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:DataConnector a owl:Class ;
    rdfs:label "DataConnector"^^xsd:string ;
    :classNumber "3.4"^^xsd:string ;
    :isa95Alignment "ISA-95 Level 2"^^xsd:string ;
    :ontologyLayer "Layer 3 — Information & Connectivity"^^xsd:string ;
    rdfs:comment "Maps semantic variable names / IRDI identifiers to device channels — the lift target for MTP NodeSet references and OPC UA Server Datasheet content (Examples A & B), and feeds R2a's requiresConcept check. Dropped a redundant data property, 'informationModel' (a loose xsd:string reference to an InformationModel by name) — the proper object property below (connectorMapsToInformationModel) already links to the actual InformationModel individual; keeping both a string reference and a real link is the same duplicate-purpose pattern as UseCase.determines, dropped in the Layer 1 pass."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:DeploymentPolicy a owl:Class ;
    rdfs:label "DeploymentPolicy"^^xsd:string ;
    :classNumber "2b.3"^^xsd:string ;
    :isa95Alignment "No ISA-95 equivalent"^^xsd:string ;
    :ontologyLayer "Layer 2b — Platform Infrastructure (Margo-Aligned)"^^xsd:string ;
    rdfs:comment "Scheduling policy per service class (replicas, resource requests, affinity). appliesToOrchestrator distinguishes Kubernetes-only fields from a Compose-based StandaloneDevice node."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:ClusterNode a owl:Class ;
    rdfs:label "ClusterNode"^^xsd:string ;
    :classNumber "2b.2"^^xsd:string ;
    :isa95Alignment "No ISA-95 equivalent"^^xsd:string ;
    :ontologyLayer "Layer 2b — Platform Infrastructure (Margo-Aligned)"^^xsd:string ;
    rdfs:comment "A single schedulable node (edge device, on-prem server, cloud VM). Properties below are lifted directly from Margo's device-requirements specification — the same one-step lift as parsing an MTP <Communication> block."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:Skill a owl:Class ;
    rdfs:label "Skill"^^xsd:string ;
    :classNumber "2.2"^^xsd:string ;
    :isa95Alignment "ISA-95 Level 3"^^xsd:string ;
    :ontologyLayer "Layer 2 — Capability, Skill, Service"^^xsd:string ;
    rdfs:comment "The functional offering of an MTP module or AAS submodel that can realise a Capability — the central bridge in R1 (realisedBy → isImplementedBy) and R2a/R2b (usesBinding/usesConnector → CommunicationBinding/DataConnector). Lifted at parse time from MTP AutomationML descriptors or AAS submodels (Examples A & B)."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:DeploymentContext a owl:Class ;
    rdfs:label "DeploymentContext"^^xsd:string ;
    :classNumber "2b.1"^^xsd:string ;
    :isa95Alignment "No ISA-95 equivalent"^^xsd:string ;
    :ontologyLayer "Layer 2b — Platform Infrastructure (Margo-Aligned)"^^xsd:string ;
    rdfs:comment "Infrastructure context (edge node, on-premise cluster, cloud region) where a Service is deployed — R3's locality/SIL check and R-Deploy's boundContext target."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:UseCaseRequirement a owl:Class ;
    rdfs:label "UseCaseRequirement"^^xsd:string ;
    :classNumber "1.3"^^xsd:string ;
    :isa95Alignment "ISA-95 Level 4"^^xsd:string ;
    :ontologyLayer "Layer 1 — Application & Requirements"^^xsd:string ;
    :swrlRule "R-Deploy (paper's R-REQ-1): UseCaseRequirement(?r) ∧ mapsToCapability(?r,?cap) ∧ realisedBy(?cap,?sk) ∧ isImplementedBy(?sk,?sv) ∧ usesBinding(?sk,?cb) ∧ CommunicationBinding(?cb) ∧ usesConnector(?sk,?dc) ∧ DataConnector(?dc) ∧ isDeployedBy(?sv,?dctx) ∧ DeploymentContext(?dctx) ∧ matchedCandidate(?r,?sv) → lifecycleStatus(?r,\"Matched\") ∧ boundService(?r,?sv) ∧ boundBinding(?r,?cb) ∧ boundConnector(?r,?dc) ∧ boundContext(?r,?dctx). Commits the SPARQL-selected candidate (R1-R3) back into the graph. FIXED (post-test-case pass): the rule previously referenced Skill's old 'uses' property (both atoms uses(?sk,?cb) and uses(?sk,?dc)), which was split into usesBinding/usesConnector during the Layer 2/3 naming pass -- this rule text had not been updated to match until now.",
        "R-Verify: UseCaseRequirement(?r) ∧ verifiedBy(?r,?vc) ∧ allCriteriaSatisfied(?r,true) → lifecycleStatus(?r,\"Verified\")"^^xsd:string,
        "R0-HardConstraint: UseCaseRequirementConstraint(?c) ∧ isHardConstraint(?c,true) ∧ constrains(?c,?req) ∧ mapsToCapability(?req,?cap) ∧ Service(?s) ∧ NOT satisfiesConstraint(?s,?c) → candidateBlocked(?s,?cap). Fires before R1. Renamed from the source ontology's own \"R-REQ-1\" to avoid colliding with the paper's rule of that name, below. FIXED (post-test-case pass): candidateBlocked was originally written as a ternary atom candidateBlocked(?s,?cap,true) -- not valid SWRL, which only supports unary/binary atoms -- corrected to a binary relation; the triple's existence already means \"blocked\"." ;
    rdfs:comment "A single atomic expectation the platform must satisfy — the anchor of R1 (Capability match) and the write target of R-Deploy / R-Verify's lifecycleStatus. Traceability links (mapsToCapability, mapsToInformationModel, mapsToDeploymentContext) match the CSS-SDA tuple defined in the paper (Sec. 4.2) exactly. Renamed from 'Requirement' to 'UseCaseRequirement' to name the class after what it actually is — a requirement scoped to a UseCase — and to disambiguate it from the generic English word once the ontology grows past this layer. RequirementParameter and RequirementConstraint (its two structural children) were renamed to match: UseCaseRequirementParameter, UseCaseRequirementConstraint. This class's former 'determines' duplicate on UseCase (an alias of hasRequirement carried over from early paper-terminology matching) was dropped as redundant."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

:Service a owl:Class ;
    rdfs:label "Service"^^xsd:string ;
    :classNumber "2.4"^^xsd:string ;
    :isa95Alignment "ISA-95 Level 3"^^xsd:string ;
    :ontologyLayer "Layer 2 — Capability, Skill, Service"^^xsd:string ;
    rdfs:comment "A deployable software unit implementing a Skill. R1 hop 3 (isImplementedBy); its reportedRecall/reportedLatency are read directly by R3's SPARQL FILTER. Extended here with the demand-side properties from Margo's Application Description spec (RequiredResources, Component) — the counterpart to the supply-side properties already on ClusterNode/DeploymentContext, so R3 can check a Service's declared needs against a node's declared capacity, both sourced from Margo rather than invented on either end. serviceVersion follows Margo's registry tag convention (metadata.version), so a version lookup against a Margo Application Registry and this property never drift apart."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

[] a owl:AllDisjointClasses ;
    owl:members ( :OTZone :DMZZone :ITZone :CloudZone :EdgeZone ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :MTPSkill :AASSkill :ControlLogicSkill :OrganisationalSkill ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :FunctionalRequirement :PerformanceRequirement :SafetyRequirement :SecurityRequirement ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :EdgeContext :OnPremContext :CloudContext :HybridContext ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :CPCService :MOService :AnalyticsService ) .

