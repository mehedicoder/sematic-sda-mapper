@prefix : <http://sda-platform.org/ontology#> .
# ----------------------------------------------------------------------------
# REQUIRED/OFFERED CAPABILITY SPLIT (this update, v2 only -- v1 untouched):
#   Prior design flaw: a single :Capability class served both the demand
#   side (UseCaseRequirement.mapsToCapability) and the supply side
#   (Skill.realises) -- meaning R1's "capability match" only worked because
#   a human pre-wired a Requirement and a Skill to the literal SAME
#   Capability node. That is identity, not matching: it can't discover a
#   provider that wasn't already known about ahead of time, which defeats
#   the actual point of a requester/provider architecture.
#
#   Fixed by splitting into two disjoint subclasses, following the CSS
#   model this ontology is built on (Bock et al., cited as [10] in the
#   paper): RequiredCapability (what a Requirement demands) and
#   OfferedCapability (what a Skill provides). Matching is now a real
#   comparison -- capabilityType string equality between independently-
#   declared RequiredCapability and OfferedCapability individuals -- not
#   shared node identity.
#     - mapsToCapability range narrowed: UseCaseRequirement -> RequiredCapability
#     - mapsTo domain narrowed: RequiredCapability -> UseCaseRequirement
#     - realises range narrowed: Skill -> OfferedCapability
#     - realisedBy domain narrowed: OfferedCapability -> Skill
#     - exposedAs domain narrowed: OfferedCapability -> Service (only ever
#       made sense on the offered side)
#   capabilityID/capabilityName/capabilityDescription/capabilityVersion/
#   operatesOn/resolvedBy remain on the shared parent :Capability, inherited
#   by both subclasses -- they apply equally to either facet.
#
#   Validated (tc_c3_required_offered_capability.py): a RequiredCapability
#   and a matching OfferedCapability, declared as two INDEPENDENT nodes never
#   wired together, are correctly matched by capabilityType comparison; a
#   wrong-type OfferedCapability is correctly excluded; and the OLD
#   identity-based query pattern is confirmed to find nothing on this data,
#   proving the fix is load-bearing, not redundant. All 11 pre-existing
#   validation checks (validate_ontology.py) still pass unchanged.
#   Now 50 classes.
# ----------------------------------------------------------------------------

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

: a owl:Ontology ;
    rdfs:label "SDA Prototype Ontology"^^xsd:string ;
    rdfs:comment "Necessary class set (Tier 1 + Tier 2) for SDA prototype development, aligned to the published CSS-SDA paper and the Margo device/application specifications."^^xsd:string ;
    owl:versionInfo "1.0.0-prototype"^^xsd:string .

:AutoLiftedMTPSkill a owl:Class ;
    rdfs:subClassOf :Skill ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Skill [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty :mtpDescriptorURI ] ) ] .

:HardConstrainedRequirement a owl:Class ;
    rdfs:subClassOf :UseCaseRequirement ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :UseCaseRequirement [ a owl:Restriction ;
                        owl:onProperty :hasConstraint ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( :UseCaseRequirementConstraint [ a owl:Restriction ;
                                            owl:hasValue true ;
                                            owl:onProperty :isHardConstraint ] ) ] ] ) ] .

:MarginCompliantClusterNode a owl:Class ;
    rdfs:subClassOf :ClusterNode ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :ClusterNode [ a owl:Restriction ;
                        owl:hasValue "StandaloneCluster"^^xsd:string ;
                        owl:onProperty :marginDeviceRole ] [ a owl:Restriction ;
                        owl:hasValue true ;
                        owl:onProperty :hasOTELCollector ] [ a owl:Restriction ;
                        owl:hasValue true ;
                        owl:onProperty :ociRuntimeCompliant ] ) ] .

:SafetyCriticalDeploymentContext a owl:Class ;
    rdfs:subClassOf :DeploymentContext ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :DeploymentContext [ a owl:Restriction ;
                        owl:onProperty :contextConstrainedBy ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( :SafetyClass [ a owl:Restriction ;
                                            owl:onProperty :safetyIntegrityLevel ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:integer ;
                                                    owl:withRestrictions ( [ xsd:minInclusive 2 ] ) ] ] ) ] ] ) ] .

:aasSubmodelRef a owl:DatatypeProperty ;
    rdfs:label "aasSubmodelRef"^^xsd:string ;
    rdfs:comment "Used as: Skill → xsd:string"^^xsd:string ;
    rdfs:domain :Skill ;
    rdfs:range xsd:string .

:accessMode a owl:DatatypeProperty ;
    rdfs:label "accessMode"^^xsd:string ;
    rdfs:comment "Used as: CommunicationBinding → xsd:string"^^xsd:string ;
    rdfs:domain :CommunicationBinding ;
    rdfs:range xsd:string .

