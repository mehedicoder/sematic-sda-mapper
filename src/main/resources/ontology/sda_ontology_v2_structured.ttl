    rdfs:comment "Used as: CommunicationBinding → xsd:anyURI"^^xsd:string ;
    rdfs:domain :CommunicationBinding ;
    rdfs:range xsd:anyURI .

:securityPolicy a owl:DatatypeProperty ;
