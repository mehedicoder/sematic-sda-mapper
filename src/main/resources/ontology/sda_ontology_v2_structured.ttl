    rdfs:comment "Used as: Capability → xsd:string"^^xsd:string ;
    rdfs:domain :Capability ;
    rdfs:range xsd:string .

:capabilityType a owl:DatatypeProperty ;
    rdfs:comment "Shared taxonomy key (e.g. 'AssetConditionMonitoring', 'TemperatureControl') used by R1 to match a RequiredCapability against an OfferedCapability by type equality, instead of requiring the two to be the same node."^^xsd:string ;
    rdfs:domain :Capability ;
    rdfs:range xsd:string .

:accuracy a owl:DatatypeProperty ;
