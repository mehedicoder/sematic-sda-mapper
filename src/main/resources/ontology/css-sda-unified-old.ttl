@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix css:  <http://www.example.org/css#> .
@prefix sda:  <http://www.example.org/sda#> .
@prefix :     <http://www.example.org/instance#> .

# ── CSS-SDA core classes (paper Figure 5, Section 4.2) ───────────────

css:UseCase       a rdfs:Class ;
    rdfs:label      "UseCase" .

sda:Requirement   a rdfs:Class ;
    rdfs:label      "Requirement" .

css:Capability    a rdfs:Class ;
    rdfs:label      "Capability" .

css:Skill         a rdfs:Class ;
    rdfs:label      "Skill" .

sda:Service       a rdfs:Class ;
    rdfs:label      "Service" .

sda:CommunicationBinding a rdfs:Class ;
    rdfs:label           "CommunicationBinding" .

sda:DataConnector       a rdfs:Class ;
    rdfs:label           "DataConnector" .

sda:DeploymentContext   a rdfs:Class ;
    rdfs:label           "DeploymentContext" .

# ── Capability sub-classes ─────────────────────────────────────────────

sda:OfferedCapability   a rdfs:Class ;
    rdfs:subClassOf      css:Capability ;
    rdfs:label           "OfferedCapability" .

sda:RequiredCapability  a rdfs:Class ;
    rdfs:subClassOf      css:Capability ;
    rdfs:label           "RequiredCapability" .

# ── Physical asset classes ─────────────────────────────────────────────

sda:MTPModule     a rdfs:Class ;
    rdfs:label    "MTPModule" .

sda:FieldDevice   a rdfs:Class ;
    rdfs:label    "FieldDevice" .

sda:BACnetDevice  a rdfs:Class ;
    rdfs:subClassOf sda:FieldDevice ;
    rdfs:label    "BACnetDevice" .

sda:EnergyMeter   a rdfs:Class ;
    rdfs:subClassOf sda:FieldDevice ;
    rdfs:label    "EnergyMeter" .

# ── NE 107 diagnostic classes ─────────────────────────────────────────

sda:NE107Status   a rdfs:Class ;
    rdfs:label    "NE107Status" .

sda:NE107SubCode  a rdfs:Class ;
    rdfs:label    "NE107SubCode" .

sda:DegradedMode  a rdfs:Class ;
    rdfs:subClassOf css:Skill ;
    rdfs:label    "DegradedMode" .

# ── Paper experiment classes (G2, G3, G8) ──────────────────────────────

sda:RequirementParameter  a rdfs:Class ;
    rdfs:label              "RequirementParameter" .

sda:RequirementConstraint a rdfs:Class ;
    rdfs:label              "RequirementConstraint" .

sda:VerificationCriterion a rdfs:Class ;
    rdfs:label              "VerificationCriterion" .

sda:Concept               a rdfs:Class ;
    rdfs:label              "Concept" .

# ── Object properties ──────────────────────────────────────────────────

sda:mapsToCapability  a rdf:Property, owl:ObjectProperty ;
    rdfs:domain        sda:RequiredCapability ;
    rdfs:range         sda:OfferedCapability ;
    rdfs:label         "mapsToCapability" .

sda:realisedBy       a rdf:Property, owl:ObjectProperty ;
    rdfs:domain        css:Capability ;
    rdfs:range         css:Skill ;
    rdfs:label         "realisedBy" .

sda:isImplementedBy  a rdf:Property, owl:ObjectProperty ;
    rdfs:domain        css:Skill ;
    rdfs:range         sda:Service ;
    rdfs:label         "isImplementedBy" .

sda:usesBinding      a rdf:Property, owl:ObjectProperty ;
    rdfs:domain        sda:Service ;
    rdfs:range         sda:CommunicationBinding ;
    rdfs:label         "usesBinding" .

sda:usesConnector    a rdf:Property, owl:ObjectProperty ;
    rdfs:domain        sda:CommunicationBinding ;
    rdfs:range         sda:DataConnector ;
    rdfs:label         "usesConnector" .

sda:isDeployedBy     a rdf:Property, owl:ObjectProperty ;
    rdfs:domain        sda:Service ;
    rdfs:range         sda:DeploymentContext ;
    rdfs:label         "isDeployedBy" .

sda:hasNE107Status   a rdf:Property, owl:ObjectProperty ;
    rdfs:domain        sda:FieldDevice ;
    rdfs:range         sda:NE107Status ;
    rdfs:label         "hasNE107Status" .

sda:hasSubCode       a rdf:Property, owl:ObjectProperty ;
    rdfs:domain        sda:NE107Status ;
    rdfs:range         sda:NE107SubCode ;
    rdfs:label         "hasSubCode" .

sda:belongsToSite    a rdf:Property, owl:ObjectProperty ;
    rdfs:domain        rdfs:Resource ;
    rdfs:range         rdfs:Resource ;
    rdfs:label         "belongsToSite" .

sda:hasParameter     a rdf:Property, owl:ObjectProperty ;
    rdfs:domain        sda:Requirement ;
    rdfs:range         rdfs:Resource ;
    rdfs:label         "hasParameter" .

sda:hasConstraint    a rdf:Property, owl:ObjectProperty ;
    rdfs:domain        sda:Requirement ;
    rdfs:range         rdfs:Resource ;
    rdfs:label         "hasConstraint" .

sda:specifiedBy      a rdf:Property, owl:ObjectProperty ;
    rdfs:domain        css:Capability ;
    rdfs:range         rdfs:Resource ;
    rdfs:label         "specifiedBy" .

sda:verifiedBy       a rdf:Property, owl:ObjectProperty ;
    rdfs:domain        sda:Requirement ;
    rdfs:range         rdfs:Resource ;
    rdfs:label         "verifiedBy" .

sda:requiresFunction a rdf:Property, owl:ObjectProperty ;
    rdfs:domain        css:Capability ;
    rdfs:range         rdfs:Resource ;
    rdfs:label         "requiresFunction" .

sda:operatesOn       a rdf:Property, owl:ObjectProperty ;
    rdfs:domain        css:Capability ;
    rdfs:range         rdfs:Resource ;
    rdfs:label         "operatesOn" .

sda:exposedAs        a rdf:Property, owl:ObjectProperty ;
    rdfs:domain        css:Capability ;
    rdfs:range         rdfs:Resource ;
    rdfs:label         "exposedAs" .

sda:mapsTo           a rdf:Property, owl:ObjectProperty ;
    rdfs:domain        sda:RequiredCapability ;
    rdfs:range         sda:OfferedCapability ;
    rdfs:label         "mapsTo" .

# ── UseCase → Requirement (G1) ──────────────────────────────────────────

sda:hasRequirement   a rdf:Property, owl:ObjectProperty ;
    rdfs:domain        css:UseCase ;
    rdfs:range         sda:Requirement ;
    rdfs:label         "hasRequirement" .

# ── R2a semantic concept matching (G8) ──────────────────────────────────

sda:requiresConcept  a rdf:Property, owl:ObjectProperty ;
    rdfs:domain        css:Skill ;
    rdfs:range         sda:Concept ;
    rdfs:label         "requiresConcept" .

sda:providesConcept  a rdf:Property, owl:ObjectProperty ;
    rdfs:domain        sda:DataConnector ;
    rdfs:range         sda:Concept ;
    rdfs:label         "providesConcept" .

# ── R-Deploy bound properties (G6) ──────────────────────────────────────

sda:boundService     a rdf:Property, owl:ObjectProperty ;
    rdfs:domain        sda:Requirement ;
    rdfs:range         sda:Service ;
    rdfs:label         "boundService" .

sda:boundBinding     a rdf:Property, owl:ObjectProperty ;
    rdfs:domain        sda:Requirement ;
    rdfs:range         sda:CommunicationBinding ;
    rdfs:label         "boundBinding" .

sda:boundConnector   a rdf:Property, owl:ObjectProperty ;
    rdfs:domain        sda:Requirement ;
    rdfs:range         sda:DataConnector ;
    rdfs:label         "boundConnector" .

sda:boundContext     a rdf:Property, owl:ObjectProperty ;
    rdfs:domain        sda:Requirement ;
    rdfs:range         sda:DeploymentContext ;
    rdfs:label         "boundContext" .

sda:matchedCandidate a rdf:Property, owl:ObjectProperty ;
    rdfs:domain        sda:Requirement ;
    rdfs:range         sda:Service ;
    rdfs:label         "matchedCandidate" .

# ── Data properties ────────────────────────────────────────────────────

sda:requirementID    a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:Requirement ;
    rdfs:range    xsd:string ;
    rdfs:label    "requirementID" .

sda:requirementType  a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:Requirement ;
    rdfs:range    xsd:string ;
    rdfs:label    "requirementType" .

sda:lifecycleStatus  a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:Requirement ;
    rdfs:range    xsd:string ;
    rdfs:label    "lifecycleStatus" .

sda:capabilityID     a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:OfferedCapability ;
    rdfs:range    xsd:string ;
    rdfs:label    "capabilityID" .

sda:reportedRecall   a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:Service ;
    rdfs:range    xsd:double ;
    rdfs:label    "reportedRecall" .

sda:reportedLatency  a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:Service ;
    rdfs:range    xsd:integer ;
    rdfs:label    "reportedLatency" .

sda:protocol         a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:CommunicationBinding ;
    rdfs:range    xsd:string ;
    rdfs:label    "protocol" .

sda:accessMode       a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:CommunicationBinding ;
    rdfs:range    xsd:string ;
    rdfs:label    "accessMode" .

sda:securityMode     a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:CommunicationBinding ;
    rdfs:range    xsd:string ;
    rdfs:label    "securityMode" .

sda:informationModel a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:DataConnector ;
    rdfs:range    xsd:string ;
    rdfs:label    "informationModel" .

sda:semanticID       a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:DataConnector ;
    rdfs:range    xsd:string ;
    rdfs:label    "semanticID" .

sda:onPlantNetwork   a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:DeploymentContext ;
    rdfs:range    xsd:boolean ;
    rdfs:label    "onPlantNetwork" .

sda:safetyIntegrityLevel a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:DeploymentContext ;
    rdfs:range    xsd:string ;
    rdfs:label    "safetyIntegrityLevel" .

sda:determinismClass a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:DeploymentContext ;
    rdfs:range    xsd:string ;
    rdfs:label    "determinismClass" .

sda:networkZone      a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:DeploymentContext ;
    rdfs:range    xsd:string ;
    rdfs:label    "networkZone" .

sda:image            a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:Service ;
    rdfs:range    xsd:string ;
    rdfs:label    "image" .

sda:engineeringUnit  a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   css:Skill ;
    rdfs:range    xsd:string ;
    rdfs:label    "engineeringUnit" .

sda:hasDiagnosticString a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:NE107Status ;
    rdfs:range    xsd:string ;
    rdfs:label    "hasDiagnosticString" .

sda:hasDegradationLevel a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:DegradedMode ;
    rdfs:range    xsd:string ;
    rdfs:label    "hasDegradationLevel" .

sda:isGateway        a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:DataConnector ;
    rdfs:range    xsd:boolean ;
    rdfs:label    "isGateway" .

# ── VerificationCriterion data properties (G3) ─────────────────────────

sda:criterionType    a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:VerificationCriterion ;
    rdfs:range    xsd:string ;
    rdfs:label    "criterionType" .

sda:criterionMetric  a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:VerificationCriterion ;
    rdfs:range    xsd:string ;
    rdfs:label    "criterionMetric" .

sda:criterionThreshold a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:VerificationCriterion ;
    rdfs:range    xsd:string ;
    rdfs:label    "criterionThreshold" .

sda:criterionOperator a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:VerificationCriterion ;
    rdfs:range    xsd:string ;
    rdfs:label    "criterionOperator" .

# ── RequirementParameter data properties (G2) ──────────────────────────

sda:parameterName    a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:RequirementParameter ;
    rdfs:range    xsd:string ;
    rdfs:label    "parameterName" .

sda:parameterValue   a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:RequirementParameter ;
    rdfs:range    xsd:string ;
    rdfs:label    "parameterValue" .

sda:parameterUnit    a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:RequirementParameter ;
    rdfs:range    xsd:string ;
    rdfs:label    "parameterUnit" .

# ── RequirementConstraint data properties (G2) ─────────────────────────

sda:constraintType   a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:RequirementConstraint ;
    rdfs:range    xsd:string ;
    rdfs:label    "constraintType" .

sda:constraintValue  a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:RequirementConstraint ;
    rdfs:range    xsd:string ;
    rdfs:label    "constraintValue" .

sda:constraintOperator a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:RequirementConstraint ;
    rdfs:range    xsd:string ;
    rdfs:label    "constraintOperator" .

# ── Requirement data properties (paper Figure 5) ────────────────────

sda:title            a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:Requirement ;
    rdfs:range    xsd:string ;
    rdfs:label    "title" .

sda:description      a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   rdfs:Resource ;
    rdfs:range    xsd:string ;
    rdfs:label    "description" .

sda:rationale        a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:Requirement ;
    rdfs:range    xsd:string ;
    rdfs:label    "rationale" .

sda:acceptanceCondition a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:Requirement ;
    rdfs:range    xsd:string ;
    rdfs:label    "acceptanceCondition" .

sda:hasPriority      a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   sda:Requirement ;
    rdfs:range    xsd:string ;
    rdfs:label    "hasPriority" .

# ── Capability data properties (paper Figure 5) ─────────────────────

sda:capabilityName   a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   css:Capability ;
    rdfs:range    xsd:string ;
    rdfs:label    "capabilityName" .

sda:version          a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   rdfs:Resource ;
    rdfs:range    xsd:string ;
    rdfs:label    "version" .

# ── Skill data properties (nominal range) ───────────────────────────

sda:nominalRange_min a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   css:Skill ;
    rdfs:range    xsd:double ;
    rdfs:label    "nominalRange_min" .

sda:nominalRange_max a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain   css:Skill ;
    rdfs:range    xsd:double ;
    rdfs:label    "nominalRange_max" .

# ── NE 107 status individuals ──────────────────────────────────────────

:NE107-Good       a sda:NE107Status ;
    rdfs:label   "Good" ;
    sda:hasDiagnosticString "" .

:NE107-Maintenance a sda:NE107Status ;
    rdfs:label   "Maintenance" ;
    sda:hasDiagnosticString "Maintenance required" .

:NE107-Failure    a sda:NE107Status ;
    rdfs:label   "Failure" ;
    sda:hasDiagnosticString "Device failure" .

:NE107-Sensor     a sda:NE107SubCode ;
    rdfs:label   "Sensor" .

:NE107-WireBreak  a sda:NE107SubCode ;
    rdfs:label   "WireBreak" .

:NE107-ShortCircuit a sda:NE107SubCode ;
    rdfs:label   "ShortCircuit" .

:NE107-Function   a sda:NE107SubCode ;
    rdfs:label   "Function" .

# ══════════════════════════════════════════════════════════════════════
# USE CASE A (MVP): Flowmeter NE 107 — Paper Section 4.4, Table I
# ══════════════════════════════════════════════════════════════════════

# UseCase individual (G1)
:UseCase-FlowmeterNE107  a css:UseCase ;
    rdfs:label            "Flowmeter Asset-Health Monitoring Use Case" ;
    sda:description       "Monitor flowmeter FT-101 health using NE 107 diagnostics to prevent unplanned downtime" ;
    sda:hasRequirement    :REQ-001 .

# PA-DIM Concept individuals (G8)
:PA-DIM-FlowConcept      a sda:Concept ;
    rdfs:label            "PA-DIM Flow Concept" ;
    sda:description       "IEC 61987-42 flow measurement concept from PA-DIM" .

:PA-DIM-TemperatureConcept  a sda:Concept ;
    rdfs:label            "PA-DIM Temperature Concept" ;
    sda:description       "IEC 61987-22 temperature measurement concept from PA-DIM" .

# Requirement
:REQ-001  a               sda:Requirement ;
    rdfs:label            "REQ-001 Flowmeter Asset-Health" ;
    sda:requirementID     "REQ-001" ;
    sda:title             "Flowmeter Asset-Health Monitoring" ;
    sda:description       "Monitor the health of flowmeter FT-101 using NAMUR NE 107 diagnostics" ;
    sda:rationale         "Prevent unplanned downtime through predictive asset diagnostics" ;
    sda:acceptanceCondition "Service must provide asset condition monitoring via OPC UA" ;
    sda:requirementType   "AssetDiagnostics" ;
    sda:lifecycleStatus   "Defined" ;
    sda:hasPriority       "High" ;
    sda:hasParameter      :REQ-001-Param-MonitoringInterval ;
    sda:hasParameter      :REQ-001-Param-AssetType ;
    sda:hasConstraint     :REQ-001-Constraint-MaxLatency ;
    sda:hasConstraint     :REQ-001-Constraint-MinRecall ;
    sda:verifiedBy        :VC-REQ001-RecallCheck ;
    sda:verifiedBy        :VC-REQ001-LatencyCheck ;
    sda:mapsToCapability  :OC-ACM-Flowmeter .

# Requirement parameters (G2)
:REQ-001-Param-MonitoringInterval  a sda:RequirementParameter ;
    rdfs:label                       "Monitoring Interval" ;
    sda:parameterName                "monitoringInterval" ;
    sda:parameterValue               "1000" ;
    sda:parameterUnit                "ms" .

:REQ-001-Param-AssetType  a sda:RequirementParameter ;
    rdfs:label              "Asset Type" ;
    sda:parameterName       "assetType" ;
    sda:parameterValue      "Flowmeter" ;
    sda:parameterUnit       "" .

# Requirement constraints (G2)
:REQ-001-Constraint-MaxLatency  a sda:RequirementConstraint ;
    rdfs:label                    "Maximum Latency" ;
    sda:constraintType            "latency" ;
    sda:constraintValue           "60" ;
    sda:constraintOperator        "<=" .

:REQ-001-Constraint-MinRecall  a sda:RequirementConstraint ;
    rdfs:label                    "Minimum Recall" ;
    sda:constraintType            "recall" ;
    sda:constraintValue           "0.90" ;
    sda:constraintOperator        ">=" .

# Verification criteria (G3)
:VC-REQ001-RecallCheck  a sda:VerificationCriterion ;
    rdfs:label              "Recall Check" ;
    sda:criterionType       "performance" ;
    sda:criterionMetric     "reportedRecall" ;
    sda:criterionThreshold  "0.90" ;
    sda:criterionOperator   ">=" .

:VC-REQ001-LatencyCheck  a sda:VerificationCriterion ;
    rdfs:label              "Latency Check" ;
    sda:criterionType       "performance" ;
    sda:criterionMetric     "reportedLatency" ;
    sda:criterionThreshold  "60" ;
    sda:criterionOperator   "<=" .

# Offered capability
:OC-ACM-Flowmeter  a     sda:OfferedCapability ;
    rdfs:label            "Asset Condition Monitoring for Flowmeter" ;
    sda:capabilityID      "ACM-001" ;
    sda:capabilityName    "AssetConditionMonitoring" ;
    sda:description       "Monitors flowmeter health via NE 107 diagnostics" ;
    sda:version           "1.0" ;
    sda:realisedBy        :SK-FlowmeterDiagnostics .

# Skill
:SK-FlowmeterDiagnostics  a css:Skill ;
    rdfs:label            "Flowmeter Diagnostics Skill" ;
    sda:engineeringUnit   "l/min" ;
    sda:nominalRange_min  0.0 ;
    sda:nominalRange_max  100.0 ;
    sda:requiresConcept   :PA-DIM-FlowConcept ;
    sda:isImplementedBy   :SVC-FlowmeterDiagnostics .

# Service
:SVC-FlowmeterDiagnostics  a sda:Service ;
    rdfs:label            "Flowmeter Diagnostics Service" ;
    sda:reportedRecall    0.94 ;
    sda:reportedLatency   45 ;
    sda:image             "registry.local/flowmeter-diagnostics:1.0" ;
    sda:usesBinding       :CB-Flowmeter-OPCUA ;
    sda:isDeployedBy      :DEPLOY-OnPrem .

# Communication binding
:CB-Flowmeter-OPCUA  a   sda:CommunicationBinding ;
    rdfs:label            "OPC-UA binding for flowmeter" ;
    sda:protocol          "OPC-UA" ;
    sda:accessMode        "read-only" ;
    sda:securityMode      "SignAndEncrypt" ;
    sda:usesConnector     :DC-Flowmeter-FT101 .

# Data connector
:DC-Flowmeter-FT101  a   sda:DataConnector ;
    rdfs:label            "FT101 flowmeter OPC-UA connector" ;
    sda:informationModel  "OPC-UA" ;
    sda:semanticID        "IEC-61987-42" ;
    sda:providesConcept   :PA-DIM-FlowConcept ;
    sda:isGateway         false .

# Deployment context
:DEPLOY-OnPrem  a        sda:DeploymentContext ;
    rdfs:label            "On-premise deployment" ;
    sda:onPlantNetwork    true ;
    sda:safetyIntegrityLevel "SIL-0" ;
    sda:determinismClass  "SoftRealTime" ;
    sda:networkZone       "OT-Zone-1" .

# ── Negative candidates (Use Case A) ──────────────────────────────────

# Wrong protocol (HTTP instead of OPC-UA)
:SVC-WrongProtocol  a    sda:Service ;
    rdfs:label            "Wrong Protocol Service" ;
    sda:reportedRecall    0.92 ;
    sda:reportedLatency   50 ;
    sda:usesBinding       :CB-WrongProtocol-HTTP .

:CB-WrongProtocol-HTTP  a sda:CommunicationBinding ;
    rdfs:label            "HTTP binding" ;
    sda:protocol          "HTTP" ;
    sda:accessMode        "read-only" ;
    sda:securityMode      "None" ;
    sda:usesConnector     :DC-WrongProtocol .

:DC-WrongProtocol  a     sda:DataConnector ;
    rdfs:label            "HTTP connector" ;
    sda:informationModel  "HTTP" ;
    sda:isGateway         false .

# Wrong capability (FermentationControl, not AssetDiagnostics)
:SVC-WrongCapability  a  sda:Service ;
    rdfs:label            "Wrong Capability Service" ;
    sda:reportedRecall    0.91 ;
    sda:reportedLatency   40 ;
    sda:usesBinding       :CB-WrongCap-OPCUA .

:CB-WrongCap-OPCUA  a   sda:CommunicationBinding ;
    rdfs:label            "OPC-UA binding for wrong capability" ;
    sda:protocol          "OPC-UA" ;
    sda:accessMode        "read-only" ;
    sda:securityMode      "SignAndEncrypt" ;
    sda:usesConnector     :DC-WrongCap .

:DC-WrongCap  a          sda:DataConnector ;
    rdfs:label            "Wrong capability connector" ;
    sda:informationModel  "OPC-UA" ;
    sda:isGateway         false .

# NE 107 Failure status (excluded by SPARQL)
:SVC-NE107Failure  a     sda:Service ;
    rdfs:label            "NE 107 Failure Service" ;
    sda:reportedRecall    0.93 ;
    sda:reportedLatency   42 ;
    sda:usesBinding       :CB-NE107Fail-OPCUA .

:CB-NE107Fail-OPCUA  a   sda:CommunicationBinding ;
    rdfs:label            "OPC-UA binding for NE 107 failure" ;
    sda:protocol          "OPC-UA" ;
    sda:accessMode        "read-only" ;
    sda:securityMode      "SignAndEncrypt" ;
    sda:usesConnector     :DC-NE107Fail .

:DC-NE107Fail  a         sda:DataConnector ;
    rdfs:label            "NE 107 failure connector" ;
    sda:informationModel  "OPC-UA" ;
    sda:isGateway         false .

# Pump asset with NE 107 status linkage
:pump1Asset  a            sda:FieldDevice ;
    rdfs:label            "Pump 1 Flowmeter" ;
    sda:hasNE107Status    :NE107-Good .

# Pump degradation modes
:pump1HealthyMode  a      sda:DegradedMode ;
    rdfs:label            "Healthy Mode" ;
    sda:hasDegradationLevel "Healthy" .

:pump1DegradedMode  a     sda:DegradedMode ;
    rdfs:label            "Degraded Mode" ;
    sda:hasDegradationLevel "Degraded" .

:pump1FaultedMode  a      sda:DegradedMode ;
    rdfs:label            "Faulted Mode" ;
    sda:hasDegradationLevel "Faulted" .

# ══════════════════════════════════════════════════════════════════════
# USE CASE B: Fermentation Skid (Skid-A1) — Critical Process Control
# ══════════════════════════════════════════════════════════════════════

# Physical asset
:Skid-A1  a               sda:MTPModule ;
    rdfs:label            "Fermentation Skid A1" ;
    sda:belongsToSite     :PlantA .

# Requirement
:REQ-002  a               sda:Requirement ;
    rdfs:label            "REQ-002 Fermentation Temperature Control" ;
    sda:requirementID     "REQ-002" ;
    sda:title             "Fermentation Temperature Control" ;
    sda:description       "Control temperature during batch fermentation step 3" ;
    sda:rationale         "Critical process control requires SIL-2 safety integrity" ;
    sda:acceptanceCondition "Service must provide HardRealTime temperature control via PROFINET" ;
    sda:requirementType   "CoreProcessControl" ;
    sda:lifecycleStatus   "Defined" ;
    sda:hasPriority       "Critical" ;
    sda:mapsToCapability  :OC-TempControl .

# Offered capabilities
:OC-TempControl  a        sda:OfferedCapability ;
    rdfs:label            "Temperature Control Capability" ;
    sda:capabilityID      "TC-001" ;
    sda:capabilityName    "TemperatureControl" ;
    sda:description       "Controls fermentation vessel temperature within ±0.5°C" ;
    sda:version           "1.0" ;
    sda:realisedBy        :SK-FermentationControl .

:OC-DosingControl  a      sda:OfferedCapability ;
    rdfs:label            "Dosing Control Capability" ;
    sda:capabilityID      "DC-001" ;
    sda:capabilityName    "DosingControl" ;
    sda:description       "Controls nutrient dosing rate during fermentation" ;
    sda:version           "1.0" ;
    sda:realisedBy        :SK-DosingControl .

# Skills
:SK-FermentationControl  a css:Skill ;
    rdfs:label            "Fermentation Control Skill" ;
    sda:engineeringUnit   "°C" ;
    sda:nominalRange_min  15.0 ;
    sda:nominalRange_max  40.0 ;
    sda:isImplementedBy   :SVC-FermentationSkid .

:SK-DosingControl  a      css:Skill ;
    rdfs:label            "Dosing Control Skill" ;
    sda:engineeringUnit   "mL/min" ;
    sda:nominalRange_min  0.0 ;
    sda:nominalRange_max  50.0 ;
    sda:isImplementedBy   :SVC-FermentationSkid .

# Service
:SVC-FermentationSkid  a  sda:Service ;
    rdfs:label            "Fermentation Skid Service" ;
    sda:reportedRecall    0.96 ;
    sda:reportedLatency   20 ;
    sda:image             "registry.local/fermentation-skid:1.0" ;
    sda:usesBinding       :CB-Skid-A1-PROFINET ;
    sda:usesBinding       :CB-Skid-A1-OPCUA ;
    sda:isDeployedBy      :DEPLOY-Critical .

# Communication bindings
:CB-Skid-A1-PROFINET  a   sda:CommunicationBinding ;
    rdfs:label            "PROFINET binding for Skid-A1" ;
    sda:protocol          "PROFINET" ;
    sda:accessMode        "read-write" ;
    sda:securityMode      "SignAndEncrypt" ;
    sda:usesConnector     :DC-Skid-A1-OPCUA .

:CB-Skid-A1-OPCUA  a     sda:CommunicationBinding ;
    rdfs:label            "OPC-UA gateway binding for Skid-A1" ;
    sda:protocol          "OPC-UA" ;
    sda:accessMode        "read-only" ;
    sda:securityMode      "SignAndEncrypt" ;
    sda:usesConnector     :DC-Skid-A1-OPCUA .

# Data connector
:DC-Skid-A1-OPCUA  a     sda:DataConnector ;
    rdfs:label            "Skid-A1 OPC-UA connector" ;
    sda:informationModel  "OPC-UA" ;
    sda:semanticID        "VDI/VDE/NAMUR 2658" ;
    sda:isGateway         true .

# Deployment context
:DEPLOY-Critical  a       sda:DeploymentContext ;
    rdfs:label            "Critical process deployment" ;
    sda:onPlantNetwork    true ;
    sda:safetyIntegrityLevel "SIL-2" ;
    sda:determinismClass  "HardRealTime" ;
    sda:networkZone       "OT-Zone-1" .

# Site
:PlantA  a                rdfs:Resource ;
    rdfs:label            "Plant A" .

