# Seed ABox — Services (predefined service catalogue).
#
# Instance namespace: http://sda-platform.org/instance#
# Ontology namespace: http://sda-platform.org/ontology#
#
# This file seeds the SERVICE side of the demo graph:
#   Service, OfferedCapability, Skill, CommunicationBinding, DataConnector,
#   ProcessVariable, SemanticConcept, Sensor, Observation, Asset, DeploymentContext,
#   SafetyClass, NetworkZone, ClusterNode.
# The REQUIREMENT side lives in seed-requirements.ttl. Both files are listed under
# app.ontology.file-paths and merged into one runtime model.
#
# Matching joins OfferedCapability (here) to RequiredCapability (requirements file)
# on sda:capabilityType, so both files must be loaded together.

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix sda:  <http://sda-platform.org/ontology#> .
@prefix :     <http://sda-platform.org/instance#> .

# =====================================================================
# Semantic Concepts (shared domain vocabulary)
# =====================================================================
:PA-DIM-FlowConcept a sda:SemanticConcept ;
    rdfs:label "PA-DIM Flow" ;
    sda:conceptID "PA-DIM-Flow" ;
    sda:conceptName "PA-DIM Flow" ;
    sda:conceptUnit "m3/h" ;
    sda:conceptDataType "xsd:decimal" .

:PA-DIM-TemperatureConcept a sda:SemanticConcept ;
    rdfs:label "PA-DIM Temperature" ;
    sda:conceptID "PA-DIM-Temperature" ;
    sda:conceptName "PA-DIM Temperature" ;
    sda:conceptUnit "degC" ;
    sda:conceptDataType "xsd:double" .

:PA-DIM-DosingConcept a sda:SemanticConcept ;
    rdfs:label "PA-DIM Dosing" ;
    sda:conceptID "PA-DIM-Dosing" ;
    sda:conceptName "PA-DIM Dosing" ;
    sda:conceptUnit "kg" ;
    sda:conceptDataType "xsd:double" .

:PA-CDD-TemperatureConcept a sda:SemanticConcept ;
    rdfs:label "IEC CDD Temperature" ;
    sda:conceptID "PA-CDD-Temperature" ;
    sda:conceptName "IEC CDD Temperature" ;
    sda:conceptUnit "degC" ;
    sda:conceptDataType "xsd:double" ;
    sda:semanticID "0112/2///61987#ABI041#001" .

# =====================================================================
# Capabilities (Offered) and Skills
# =====================================================================
:CAP-FlowDiagnostics-Offered a sda:OfferedCapability ;
    rdfs:label "Flowmeter Diagnostics (Offered)" ;
    sda:capabilityID "CAP-FLOW-DIAG-001" ;
    sda:capabilityName "Flowmeter Diagnostics" ;
    sda:capabilityDescription "Diagnose FT-101 flowmeter health and alarm state." ;
    sda:capabilityVersion "1.0" ;
    sda:capabilityType "FlowDiagnostics" ;
    sda:realisedBy :SK-FlowmeterDiagnostics .

:CAP-FermentationControl-Offered a sda:OfferedCapability ;
    rdfs:label "Fermentation Control (Offered)" ;
    sda:capabilityID "CAP-FERM-CTRL-001" ;
    sda:capabilityName "Fermentation Control" ;
    sda:capabilityDescription "Control the fermentation skid process." ;
    sda:capabilityVersion "1.0" ;
    sda:capabilityType "FermentationControl" ;
    sda:realisedBy :SK-FermentationControl .

:CAP-HVACTempMonitoring-Offered a sda:OfferedCapability ;
    rdfs:label "HVAC Temperature Monitoring (Offered)" ;
    sda:capabilityID "CAP-HVAC-TEMP-001" ;
    sda:capabilityName "HVAC Temperature Monitoring" ;
    sda:capabilityDescription "Monitor AHU-01 supply-air temperature." ;
    sda:capabilityVersion "1.0" ;
    sda:capabilityType "HVACTempMonitoring" ;
    sda:realisedBy :SK-HVACTempAnalysis .

:CAP-ProcessVariableAnalysis-Offered a sda:OfferedCapability ;
    rdfs:label "Process Variable Analysis (Offered)" ;
    sda:capabilityID "CAP-PVA-001" ;
    sda:capabilityName "Process Variable Analysis" ;
    sda:capabilityDescription "Analyse a process variable analytically." ;
    sda:capabilityVersion "1.0" ;
    sda:capabilityType "ProcessVariableAnalysis" ;
    sda:realisedBy :SK-ProcessVariableAnalysis .

:SK-FlowmeterDiagnostics a sda:Skill ;
    rdfs:label "Flowmeter Diagnostics Skill" ;
    sda:skillID "SK-FLOW-DIAG-001" ;
    sda:skillName "Flowmeter Diagnostics Skill" ;
    sda:skillDescription "Diagnostic skill for FT-101." ;
    sda:skillVersion "1.0" ;
    sda:requiresConcept :PA-DIM-FlowConcept ;
    sda:isImplementedBy :SVC-FlowmeterDiagnostics .

:SK-FermentationControl a sda:Skill ;
    rdfs:label "Fermentation Control Skill" ;
    sda:skillID "SK-FERM-CTRL-001" ;
    sda:skillName "Fermentation Control Skill" ;
    sda:skillDescription "Control skill for Skid-A1." ;
    sda:skillVersion "1.0" ;
    sda:requiresConcept :PA-DIM-TemperatureConcept, :PA-DIM-DosingConcept ;
    sda:isImplementedBy :SVC-FermentationSkid .

:SK-HVACTempAnalysis a sda:Skill ;
    rdfs:label "HVAC Temperature Analysis Skill" ;
    sda:skillID "SK-HVAC-TEMP-001" ;
    sda:skillName "HVAC Temperature Analysis Skill" ;
    sda:skillDescription "Temperature analysis skill for AHU-01." ;
    sda:skillVersion "1.0" ;
    sda:requiresConcept :PA-DIM-TemperatureConcept ;
    sda:isImplementedBy :SVC-HVACTempAnalysis .

:SK-ProcessVariableAnalysis a sda:Skill ;
    rdfs:label "Process Variable Analysis Skill" ;
    sda:skillID "SK-PVA-001" ;
    sda:skillName "Process Variable Analysis Skill" ;
    sda:skillDescription "Analytics skill over a process variable." ;
    sda:skillVersion "1.0" ;
    sda:requiresConcept :PA-CDD-TemperatureConcept ;
    sda:isImplementedBy :SVC-ProcessVariableAnalytics .

# =====================================================================
# Services
# =====================================================================
:SVC-FlowmeterDiagnostics a sda:Service ;
    rdfs:label "Flowmeter Diagnostics Service" ;
    sda:serviceID "SVC-FLOW-DIAG-001" ;
    sda:serviceName "Flowmeter Diagnostics Service" ;
    sda:serviceType "Diagnostics" ;
    sda:reportedRecall 0.94 ;
    sda:reportedLatency 45 ;
    sda:hasBinding :CB-FT101-OPCUA ;
    sda:hasConnector :DC-FT101-OPCUA ;
    sda:isImplementedBy :SK-FlowmeterDiagnostics ;
    sda:isDeployedBy :DEPLOY-OnPrem ;
    sda:satisfiesConstraint :CON-REQ001, :CON-REQ001-Recall .

:SVC-FermentationSkid a sda:Service ;
    rdfs:label "Fermentation Skid Service" ;
    sda:serviceID "SVC-FERM-SKID-001" ;
    sda:serviceName "Fermentation Skid Service" ;
    sda:serviceType "Control" ;
    sda:reportedRecall 0.93 ;
    sda:reportedLatency 50 ;
    sda:hasBinding :CB-SkidA1-PROFINET ;
    sda:hasConnector :DC-SkidA1-OPCUA ;
    sda:isImplementedBy :SK-FermentationControl ;
    sda:isDeployedBy :DEPLOY-Critical ;
    sda:satisfiesConstraint :CON-REQ002, :CON-REQ002-Protocol .

:SVC-HVACTempAnalysis a sda:Service ;
    rdfs:label "HVAC Temperature Analysis Service" ;
    sda:serviceID "SVC-HVAC-TEMP-001" ;
    sda:serviceName "HVAC Temperature Analysis Service" ;
    sda:serviceType "Monitoring" ;
    sda:reportedRecall 0.91 ;
    sda:reportedLatency 55 ;
    sda:hasBinding :CB-AHU01-OPCUA ;
    sda:hasConnector :DC-AHU01-OPCUA ;
    sda:isImplementedBy :SK-HVACTempAnalysis ;
    sda:isDeployedBy :DEPLOY-OTZone3 ;
    sda:satisfiesConstraint :CON-REQ003 .

:SVC-Orphan a sda:Service ;
    rdfs:label "Unmapped Standalone Service" ;
    sda:serviceID "SVC-ORPHAN-001" ;
    sda:serviceName "Unmapped Standalone Service" ;
    sda:serviceType "Diagnostics" ;
    sda:reportedRecall 0.85 ;
    sda:reportedLatency 42 ;
    sda:hasBinding :CB-Orphan-OPCUA ;
    sda:hasConnector :DC-Orphan-OPCUA ;
    sda:isDeployedBy :DEPLOY-OTZone3 .

:SVC-ProcessVariableAnalytics a sda:Service ;
    rdfs:label "Process Variable Analytics Service" ;
    sda:serviceID "SVC-PVA-001" ;
    sda:serviceName "Process Variable Analytics Service" ;
    sda:serviceType "Analytics" ;
    sda:reportedRecall 0.92 ;
    sda:reportedLatency 50 ;
    sda:hasBinding :CB-PVA-OPCUA ;
    sda:hasConnector :DC-PVA-OPCUA ;
    sda:isImplementedBy :SK-ProcessVariableAnalysis ;
    sda:isDeployedBy :DEPLOY-PVA .

# =====================================================================
# Communication Bindings
# =====================================================================
:CB-FT101-OPCUA a sda:CommunicationBinding ;
    rdfs:label "OPC-UA binding for flowmeter" ;
    sda:bindingID "CB-FT101-OPCUA" ;
    sda:protocol "OPC-UA" ;
    sda:accessMode "read-only" ;
    sda:securityMode "Sign" ;
    sda:bindingEndpointUri "opc.tcp://opcua-ft101:4840" ;
    sda:bindsService :SVC-FlowmeterDiagnostics .

:CB-SkidA1-PROFINET a sda:CommunicationBinding ;
    rdfs:label "Skid-A1 PROFINET binding" ;
    sda:bindingID "CB-SkidA1-PROFINET" ;
    sda:protocol "PROFINET" ;
    sda:accessMode "read-write" ;
    sda:securityMode "None" ;
    sda:bindingEndpointUri "profinet://skid-a1:1" ;
    sda:bindsService :SVC-FermentationSkid .

:CB-AHU01-OPCUA a sda:CommunicationBinding ;
    rdfs:label "AHU-01 OPC-UA binding" ;
    sda:bindingID "CB-AHU01-OPCUA" ;
    sda:protocol "OPC-UA" ;
    sda:accessMode "read-only" ;
    sda:securityMode "SignAndEncrypt" ;
    sda:bindingEndpointUri "opc.tcp://opcua-ahu01:4840" ;
    sda:bindsService :SVC-HVACTempAnalysis .

:CB-Orphan-OPCUA a sda:CommunicationBinding ;
    rdfs:label "Orphan OPC-UA binding" ;
    sda:bindingID "CB-Orphan-OPCUA" ;
    sda:protocol "OPC-UA" ;
    sda:accessMode "read-only" ;
    sda:securityMode "Sign" ;
    sda:bindingEndpointUri "opc.tcp://opcua-orphan:4840" ;
    sda:bindsService :SVC-Orphan .

:CB-PVA-OPCUA a sda:CommunicationBinding ;
    rdfs:label "PVA OPC-UA binding" ;
    sda:bindingID "CB-PVA-OPCUA" ;
    sda:protocol "OPC-UA" ;
    sda:accessMode "read-only" ;
    sda:securityMode "Sign" ;
    sda:bindingEndpointUri "opc.tcp://opcua-pva:4840" ;
    sda:bindsService :SVC-ProcessVariableAnalytics .

# =====================================================================
# Data Connectors
# =====================================================================
:DC-FT101-OPCUA a sda:DataConnector ;
    rdfs:label "FT101 flowmeter OPC-UA connector" ;
    sda:connectorID "DC-FT101-OPCUA" ;
    sda:connectorType "OPC-UA" ;
    sda:connectorSemanticIRI "http://example.org/opcua/FT101" ;
    sda:dataType "Double" ;
    sda:mapsVariable :PV-Flow-FT101 ;
    sda:connectsService :SVC-FlowmeterDiagnostics .

:DC-SkidA1-OPCUA a sda:DataConnector ;
    rdfs:label "Skid-A1 OPC-UA connector" ;
    sda:connectorID "DC-SkidA1-OPCUA" ;
    sda:connectorType "OPC-UA" ;
    sda:connectorSemanticIRI "http://example.org/opcua/SkidA1" ;
    sda:dataType "Double" ;
    sda:mapsVariable :PV-Temp-SkidA1, :PV-Dosing-SkidA1 ;
    sda:connectsService :SVC-FermentationSkid .

:DC-AHU01-OPCUA a sda:DataConnector ;
    rdfs:label "AHU01 OPC-UA connector" ;
    sda:connectorID "DC-AHU01-OPCUA" ;
    sda:connectorType "OPC-UA" ;
    sda:connectorSemanticIRI "http://example.org/opcua/AHU01" ;
    sda:dataType "Double" ;
    sda:mapsVariable :PV-Temp-AHU01 ;
    sda:connectsService :SVC-HVACTempAnalysis .

:DC-Orphan-OPCUA a sda:DataConnector ;
    rdfs:label "Orphan OPC-UA connector" ;
    sda:connectorID "DC-Orphan-OPCUA" ;
    sda:connectorType "OPC-UA" ;
    sda:connectorSemanticIRI "http://example.org/opcua/Orphan" ;
    sda:dataType "Double" ;
    sda:mapsVariable :PV-Orphan ;
    sda:connectsService :SVC-Orphan .

:DC-PVA-OPCUA a sda:DataConnector ;
    rdfs:label "PVA OPC-UA connector" ;
    sda:connectorID "DC-PVA-OPCUA" ;
    sda:connectorType "OPC-UA" ;
    sda:connectorSemanticIRI "http://example.org/opcua/PVA" ;
    sda:dataType "Double" ;
    sda:mapsVariable :PV-PVA-Temperature ;
    sda:connectsService :SVC-ProcessVariableAnalytics .

# =====================================================================
# Process Variables, Sensors, Observations, Assets
# =====================================================================
:PV-Flow-FT101 a sda:ProcessVariable ;
    rdfs:label "FT101 flow rate" ;
    sda:variableName "FT101 flow rate" ;
    sda:variableUnit "m3/h" ;
    sda:describedBy :PA-DIM-FlowConcept ;
    sda:hasObservation :OBS-FT101-1, :OBS-FT101-2 .

:PV-Temp-SkidA1 a sda:ProcessVariable ;
    rdfs:label "Skid-A1 Fermentation Temperature" ;
    sda:variableName "Skid-A1 Fermentation Temperature" ;
    sda:variableUnit "degC" ;
    sda:describedBy :PA-DIM-TemperatureConcept ;
    sda:hasObservation :OBS-TEMP-SkidA1-1 .

:PV-Dosing-SkidA1 a sda:ProcessVariable ;
    rdfs:label "Skid-A1 Dosing Rate" ;
    sda:variableName "Skid-A1 Dosing Rate" ;
    sda:variableUnit "kg" ;
    sda:describedBy :PA-DIM-DosingConcept ;
    sda:hasObservation :OBS-DOSING-SkidA1-1 .

:PV-Temp-AHU01 a sda:ProcessVariable ;
    rdfs:label "AHU01 Supply Air Temperature" ;
    sda:variableName "AHU01 Supply Air Temperature" ;
    sda:variableUnit "degC" ;
    sda:describedBy :PA-DIM-TemperatureConcept ;
    sda:hasObservation :OBS-TEMP-AHU01-1 .

:PV-Orphan a sda:ProcessVariable ;
    rdfs:label "Orphan flow rate" ;
    sda:variableName "Orphan flow rate" ;
    sda:variableUnit "m3/h" ;
    sda:describedBy :PA-DIM-FlowConcept ;
    sda:hasObservation :OBS-Orphan-1 .

:PV-PVA-Temperature a sda:ProcessVariable ;
    rdfs:label "PVA analysed temperature" ;
    sda:variableName "PVA analysed temperature" ;
    sda:variableUnit "degC" ;
    sda:describedBy :PA-CDD-TemperatureConcept ;
    sda:hasObservation :OBS-PVA-1 .

:Sensor-FT101 a sda:Sensor ;
    rdfs:label "FT101 Flow Sensor" ;
    sda:sensorID "FT101" ;
    sda:sensorType "Coriolis" ;
    sda:locatedIn :FT101 ;
    sda:observes :PV-Flow-FT101 .

:Sensor-AHU01 a sda:Sensor ;
    rdfs:label "AHU01 Temperature Sensor" ;
    sda:sensorID "AHU01-TEMP" ;
    sda:sensorType "RTD" ;
    sda:locatedIn :AHU01 ;
    sda:observes :PV-Temp-AHU01 .

:OBS-FT101-1 a sda:Observation ;
    rdfs:label "FT101 flow observation 1" ;
    sda:value 42.5 ;
    sda:timestamp "2026-08-05T10:15:00Z"^^xsd:dateTime ;
    sda:observes :PV-Flow-FT101 .

:OBS-FT101-2 a sda:Observation ;
    rdfs:label "FT101 flow observation 2" ;
    sda:value 43.1 ;
    sda:timestamp "2026-08-05T10:30:00Z"^^xsd:dateTime ;
    sda:observes :PV-Flow-FT101 .

:OBS-TEMP-SkidA1-1 a sda:Observation ;
    rdfs:label "Skid-A1 temperature observation 1" ;
    sda:value 28.4 ;
    sda:timestamp "2026-08-05T10:20:00Z"^^xsd:dateTime ;
    sda:observes :PV-Temp-SkidA1 .

:OBS-DOSING-SkidA1-1 a sda:Observation ;
    rdfs:label "Skid-A1 dosing observation 1" ;
    sda:value 15.2 ;
    sda:timestamp "2026-08-05T10:22:00Z"^^xsd:dateTime ;
    sda:observes :PV-Dosing-SkidA1 .

:OBS-TEMP-AHU01-1 a sda:Observation ;
    rdfs:label "AHU01 temperature observation 1" ;
    sda:value 22.0 ;
    sda:timestamp "2026-08-05T10:25:00Z"^^xsd:dateTime ;
    sda:observes :PV-Temp-AHU01 .

:OBS-Orphan-1 a sda:Observation ;
    rdfs:label "Orphan flow observation 1" ;
    sda:value 12.0 ;
    sda:timestamp "2026-08-05T10:35:00Z"^^xsd:dateTime ;
    sda:observes :PV-Orphan .

:OBS-PVA-1 a sda:Observation ;
    rdfs:label "PVA observation 1" ;
    sda:value 36.6 ;
    sda:timestamp "2026-08-05T11:00:00Z"^^xsd:dateTime ;
    sda:observes :PV-PVA-Temperature .

:FT101 a sda:Asset ;
    rdfs:label "FT101 Flowmeter" ;
    sda:assetID "FT101" ;
    sda:assetName "FT101 Flowmeter" ;
    sda:locatedIn :PlantA ;
    sda:hasCapability :CAP-FlowDiagnostics-Offered ;
    sda:hasContext :Context-FT101 .

:AHU01 a sda:Asset ;
    rdfs:label "AHU01 Air Handling Unit" ;
    sda:assetID "AHU01" ;
    sda:assetName "AHU01 Air Handling Unit" ;
    sda:locatedIn :PlantA ;
    sda:hasCapability :CAP-HVACTempMonitoring-Offered ;
    sda:hasContext :Context-AHU01 .

:Skid-A1 a sda:Asset ;
    rdfs:label "Skid-A1 Fermentation Skid" ;
    sda:assetID "Skid-A1" ;
    sda:assetName "Skid-A1 Fermentation Skid" ;
    sda:locatedIn :PlantB ;
    sda:hasCapability :CAP-FermentationControl-Offered ;
    sda:hasContext :Context-SkidA1 .

# =====================================================================
# Asset Contexts
# =====================================================================
:Context-FT101 a sda:DeploymentContext ;
    rdfs:label "FT-101 context" ;
    sda:contextID "Context-FT101" ;
    sda:locatedInZone :NZ-OT1 ;
    sda:contextConstrainedBy :SCL-OnPrem ;
    sda:determinismClass "SoftRealTime" ;
    sda:onPlantNetwork true ;
    sda:hostsService :SVC-FlowmeterDiagnostics .

:Context-SkidA1 a sda:DeploymentContext ;
    rdfs:label "Skid-A1 context" ;
    sda:contextID "Context-SkidA1" ;
    sda:locatedInZone :NZ-OT1 ;
    sda:contextConstrainedBy :SCL-Critical ;
    sda:determinismClass "HardRealTime" ;
    sda:onPlantNetwork true ;
    sda:hostsService :SVC-FermentationSkid .

:Context-AHU01 a sda:DeploymentContext ;
    rdfs:label "AHU-01 context" ;
    sda:contextID "Context-AHU01" ;
    sda:locatedInZone :NZ-OT3 ;
    sda:contextConstrainedBy :SCL-OTZone3 ;
    sda:determinismClass "SoftRealTime" ;
    sda:onPlantNetwork true ;
    sda:hostsService :SVC-HVACTempAnalysis .

# =====================================================================
# Deployment Contexts (service deployment environments)
# =====================================================================
:DEPLOY-OnPrem a sda:DeploymentContext ;
    rdfs:label "On-premise deployment" ;
    sda:contextID "DEPLOY-OnPrem" ;
    sda:locatedInZone :NZ-OT1 ;
    sda:contextConstrainedBy :SCL-OnPrem ;
    sda:determinismClass "SoftRealTime" ;
    sda:onPlantNetwork true ;
    sda:hostsService :SVC-FlowmeterDiagnostics .

:DEPLOY-Critical a sda:DeploymentContext ;
    rdfs:label "Critical deployment" ;
    sda:contextID "DEPLOY-Critical" ;
    sda:locatedInZone :NZ-OT1 ;
    sda:contextConstrainedBy :SCL-Critical ;
    sda:determinismClass "HardRealTime" ;
    sda:onPlantNetwork true ;
    sda:hostsService :SVC-FermentationSkid .

:DEPLOY-OTZone3 a sda:DeploymentContext ;
    rdfs:label "OT Zone 3 deployment" ;
    sda:contextID "DEPLOY-OTZone3" ;
    sda:locatedInZone :NZ-OT3 ;
    sda:contextConstrainedBy :SCL-OTZone3 ;
    sda:determinismClass "SoftRealTime" ;
    sda:onPlantNetwork true ;
    sda:hostsService :SVC-HVACTempAnalysis, :SVC-Orphan .

:DEPLOY-PVA a sda:DeploymentContext ;
    rdfs:label "PVA OT deployment" ;
    sda:contextID "DEPLOY-PVA" ;
    sda:locatedInZone :NZ-OT1 ;
    sda:contextConstrainedBy :SCL-OnPrem ;
    sda:determinismClass "SoftRealTime" ;
    sda:onPlantNetwork true ;
    sda:hostsService :SVC-ProcessVariableAnalytics .

# =====================================================================
# Safety Classes
# =====================================================================
:SCL-OnPrem a sda:SafetyClass ;
    rdfs:label "On-premise SIL-0" ;
    sda:classID "SCL-OnPrem" ;
    sda:safetyIntegrityLevel "SIL-0" ;
    sda:safetyStandard "IEC 61508" ;
    sda:certificationRequired false .

:SCL-Critical a sda:SafetyClass ;
    rdfs:label "Critical SIL-2" ;
    sda:classID "SCL-Critical" ;
    sda:safetyIntegrityLevel "SIL-2" ;
    sda:safetyStandard "IEC 61508" ;
    sda:certificationRequired true .

:SCL-OTZone3 a sda:SafetyClass ;
    rdfs:label "OT Zone 3 SIL-0" ;
    sda:classID "SCL-OTZone3" ;
    sda:safetyIntegrityLevel "SIL-0" ;
    sda:safetyStandard "IEC 62443" ;
    sda:certificationRequired false .

# =====================================================================
# Network Zones
# =====================================================================
:NZ-OT1 a sda:OTZone ;
    rdfs:label "OT-Zone-1" ;
    sda:zoneID "OT-Zone-1" ;
    sda:iec62443Level "Level 3" ;
    sda:internetReachable false ;
    sda:containsNode :Node-OT1-A, :Node-OT1-B .

:NZ-OT3 a sda:OTZone ;
    rdfs:label "OT-Zone-3" ;
    sda:zoneID "OT-Zone-3" ;
    sda:iec62443Level "Level 3" ;
    sda:internetReachable false ;
    sda:containsNode :Node-OT3-A, :Node-OT3-B, :Node-OT3-C .

:NZ-IT a sda:ITZone ;
    rdfs:label "IT-Zone-1" ;
    sda:zoneID "IT-Zone-1" ;
    sda:iec62443Level "Level 4" ;
    sda:internetReachable true .

:PlantA a rdfs:Resource ;
    rdfs:label "Plant A" .

:PlantB a rdfs:Resource ;
    rdfs:label "Plant B" .

# =====================================================================
# Cluster Nodes
# =====================================================================
:Node-OT1-A a sda:ClusterNode ;
    rdfs:label "node-ot1-a" ;
    sda:nodeID "Node-OT1-A" ;
    sda:hostname "node-ot1-a" ;
    sda:secureBootEnabled true ;
    sda:hasOTELCollector false ;
    sda:cpuArchitectures "x86_64" ;
    sda:cpuCores 4 .

:Node-OT1-B a sda:ClusterNode ;
    rdfs:label "node-ot1-b" ;
    sda:nodeID "Node-OT1-B" ;
    sda:hostname "node-ot1-b" ;
    sda:secureBootEnabled true ;
    sda:hasOTELCollector false ;
    sda:cpuArchitectures "x86_64" ;
    sda:cpuCores 8 .

:Node-OT3-A a sda:ClusterNode ;
    rdfs:label "node-ot3-a" ;
    sda:nodeID "Node-OT3-A" ;
    sda:hostname "node-ot3-a" ;
    sda:secureBootEnabled true ;
    sda:hasOTELCollector true ;
    sda:cpuArchitectures "x86_64" ;
    sda:cpuCores 4 .

:Node-OT3-B a sda:ClusterNode ;
    rdfs:label "node-ot3-b" ;
    sda:nodeID "Node-OT3-B" ;
    sda:hostname "node-ot3-b" ;
