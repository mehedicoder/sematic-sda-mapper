:candidateBlocked a owl:ObjectProperty ;
    rdfs:comment "Write target of R0-HardConstraint. FIXED during this pass: the rule text originally wrote this as a ternary atom, candidateBlocked(?s,?cap,true) — not valid SWRL, which only supports unary/binary atoms. Corrected to a binary relation (Capability -> Service); the triple's existence means 'blocked', so the trailing boolean was redundant as well as invalid."^^xsd:string ;
    rdfs:domain :Capability ;
    rdfs:range :Service .

:capabilityDescription a owl:DatatypeProperty ;
    rdfs:label "capabilityDescription"^^xsd:string ;
    rdfs:comment "Used as: Capability → xsd:string"^^xsd:string ;
    rdfs:domain :Capability ;
    rdfs:range xsd:string .

:capabilityID a owl:DatatypeProperty ;
    rdfs:label "capabilityID"^^xsd:string ;
    rdfs:comment "Used as: Capability → xsd:string"^^xsd:string ;
    rdfs:domain :Capability ;
    rdfs:range xsd:string .

:capabilityName a owl:DatatypeProperty ;
