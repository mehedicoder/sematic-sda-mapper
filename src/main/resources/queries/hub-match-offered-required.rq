PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sda:  <https://example.org/ontology/sda#>

# Semantic match between an inferred sda:OfferedCapability and an
# sda:RequiredCapability across all three CSS-SDA dimensions simultaneously
# (paper, Step 5):
#   1. Capability dimension:     functionClass equality, engineering unit
#                                compatibility, nominal range containment and
#                                SIL sufficiency.
#   2. Communication dimension:  binding protocol of the matched service.
#   3. Deployment dimension:     network zone of the deployment context.
# The matched skill, service and endpoint are projected together with the SIL
# evidence.
SELECT ?required ?offered ?skill ?service ?serviceName ?endpointUrl ?protocol ?networkZone ?sil
WHERE {
    # Capability dimension: the required function class drives the match.
    ?required a sda:RequiredCapability ;
              sda:functionClass ?reqFunctionClass .
    OPTIONAL { ?required sda:engineeringUnit ?reqUnit }
    OPTIONAL { ?required sda:nominalRange_min ?reqMin }
    OPTIONAL { ?required sda:nominalRange_max ?reqMax }
    OPTIONAL { ?required sda:safetyIntegrityLevel ?reqSil }
    OPTIONAL { ?required sda:protocol ?reqProtocol }
    OPTIONAL { ?required sda:networkZone ?reqZone }

    ?offered a sda:OfferedCapability ;
             sda:functionClass ?reqFunctionClass ;
             sda:realisedBy ?skill .
    OPTIONAL { ?offered sda:engineeringUnit ?offUnit }
    OPTIONAL { ?offered sda:nominalRange_min ?offMin }
    OPTIONAL { ?offered sda:nominalRange_max ?offMax }
    OPTIONAL { ?offered sda:safetyIntegrityLevel ?sil }

    # Communication dimension: the matched skill is implemented by a service
    # that uses a binding with a protocol and an endpoint.
    ?skill sda:isImplementedBy ?service .
    OPTIONAL { ?service rdfs:label ?serviceName }
    ?service sda:uses ?binding .
    ?binding sda:protocol ?protocol .
    OPTIONAL { ?binding sda:endpointUrl ?endpointUrl }

    # Deployment dimension: the matched service is deployed in a context that
    # defines a network zone.
    OPTIONAL {
        ?service sda:isDeployedBy ?deployment .
        OPTIONAL { ?deployment sda:networkZone ?networkZone }
    }

    # Capability dimension: engineering unit must be equal when required.
    FILTER(!BOUND(?reqUnit) || ?reqUnit = ?offUnit)

    # Capability dimension: the offered nominal range must contain the required
    # range; a required bound forces the offered bound to be present.
    FILTER(
        (!BOUND(?reqMin) || (BOUND(?offMin) && xsd:double(?offMin) <= xsd:double(?reqMin))) &&
        (!BOUND(?reqMax) || (BOUND(?offMax) && xsd:double(?offMax) >= xsd:double(?reqMax)))
    )

    # Capability dimension: the offered SIL must be at least the required SIL.
    FILTER(!BOUND(?reqSil) || (BOUND(?sil) && ?sil >= ?reqSil))

    # Communication dimension: the binding protocol must match when required.
    FILTER(!BOUND(?reqProtocol) || ?reqProtocol = ?protocol)

    # Deployment dimension: the network zone must match when required.
    FILTER(!BOUND(?reqZone) || ?reqZone = ?networkZone)
}
ORDER BY ?required ?offered
