<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <app name="semantic-sda-mapper" />

    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="semantic-sda-mapper" />

    <!-- Console output for dev / default profile -->
    <springProfile name="!prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%5p) [%green(${APP_NAME}),%yellow(%X{traceId:-}),%yellow(%X{spanId:-})] %cyan(%40.40logger{40}) %msg%n</pattern>
            </encoder>
        </appender>
        <root level="${LOG_LEVEL:-INFO}">
            <appender-ref ref="CONSOLE" />
        </root>
    </springProfile>

    <!-- JSON output for prod profile -->
    <springProfile name="prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"app":"${APP_NAME}"}</customFields>
                <includeMdcKeyName>traceId</includeMdcKeyName>
                <includeMdcKeyName>spanId</includeMdcKeyName>
                <fieldNames>
                    <timestamp>timestamp</timestamp>
                    <version>[ignore]</version>
                </fieldNames>
            </encoder>
        </appender>
        <root level="${LOG_LEVEL:-INFO}">
            <appender-ref ref="CONSOLE" />
        </root>
    </springProfile>

</configuration>
