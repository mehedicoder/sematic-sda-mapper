PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sda:  <http://sda-platform.org/ontology#>
PREFIX :     <http://sda-platform.org/instance#>

SELECT ?requirement ?capability ?skill ?service ?binding ?protocol ?accessMode ?recall ?latency ?networkZone ?safetyIntegrityLevel ?determinismClass ?connector ?connectorLabel ?deploy ?deployLabel
WHERE {
    # Bind the requirement to match (placeholder replaced at runtime)
    BIND(:REQ-003 AS ?requirement)

    # R1: Capability match chain
    ?requirement  a                  sda:UseCaseRequirement ;
                 sda:mapsToCapability ?capability .

    ?capability   sda:realisedBy      ?skill .

    ?skill        sda:isImplementedBy  ?service .

    # R2b: Protocol match (OPC-UA for HVAC monitoring)
    ?service      sda:hasBinding      ?binding .

    ?binding      sda:protocol        ?protocol ;
                  sda:accessMode      ?accessMode .

    ?service      sda:hasConnector    ?connector .

    ?connector    rdfs:label          ?connectorLabel .

    FILTER (?protocol = "OPC-UA")
    FILTER (?accessMode = "read-only")

    # R3: Performance, locality, and deployment constraints
    ?service      sda:reportedRecall  ?recall ;
                  sda:reportedLatency ?latency .

    FILTER (?recall >= 0.90)
    FILTER (?latency <= 60)

    ?service      sda:isDeployedBy    ?deploy .

    ?deploy       rdfs:label          ?deployLabel ;
                  sda:onPlantNetwork  ?onPlantNetwork ;
                  sda:locatedInZone   ?zone .

    ?zone         rdfs:label          ?networkZone .

    FILTER (?onPlantNetwork = true)
    FILTER (?networkZone = "OT-Zone-3")

    OPTIONAL {
        ?deploy sda:contextConstrainedBy ?safetyClass .
        ?safetyClass sda:safetyIntegrityLevel ?safetyIntegrityLevel
    }
    OPTIONAL { ?deploy sda:determinismClass ?determinismClass }

    # R2a: Semantic concept coverage (paper Table I)
    FILTER NOT EXISTS {
        ?skill sda:requiresConcept ?requiredConcept .
        FILTER NOT EXISTS {
            ?service sda:hasConnector ?dc .
            ?dc sda:mapsVariable ?pv .
            ?pv sda:describedBy ?requiredConcept .
        }
    }
}
ORDER BY DESC(?recall)
LIMIT 1
