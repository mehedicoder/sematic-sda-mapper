PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sda:  <https://example.org/ontology/sda#>
PREFIX :     <http://www.example.org/instance#>

SELECT ?requirement ?capability ?skill ?service ?binding ?protocol ?accessMode ?recall ?latency ?onPlantNetwork ?connector ?connectorLabel ?deploy ?deployLabel ?safetyIntegrityLevel ?determinismClass ?networkZone
WHERE {
    # Bind the requirement to match (placeholder replaced at runtime)
    BIND(:REQ-001 AS ?requirement)

    # R1: Capability match chain (paper Table I)
    # REQ → mapsToCapability → Capability → realisedBy → Skill → isImplementedBy → Service
    ?requirement  a                  sda:Requirement ;
                 sda:mapsToCapability ?capability .

    ?capability   sda:realisedBy      ?skill .

    ?skill        sda:isImplementedBy  ?service .

    # R2b: Protocol match (paper Table I)
    # Service must use an OPC-UA read-only CommunicationBinding
    ?service      sda:hasBinding      ?binding .

    ?binding      sda:protocol        ?protocol ;
                  sda:accessMode      ?accessMode .

    ?service      sda:hasConnector    ?connector .

    ?connector    rdfs:label          ?connectorLabel .

    FILTER (?protocol = "OPC-UA")
    FILTER (?accessMode = "read-only")

    # R3: Performance and locality constraints (paper Table I)
    # reportedRecall >= 0.90, reportedLatency <= 60, onPlantNetwork = true
    ?service      sda:reportedRecall  ?recall ;
                  sda:reportedLatency ?latency .

    FILTER (?recall >= 0.90)
    FILTER (?latency <= 60)

    ?service      sda:isDeployedBy    ?deploy .

    ?deploy       rdfs:label          ?deployLabel ;
                  sda:onPlantNetwork  ?onPlantNetwork .

    FILTER (?onPlantNetwork = true)

    OPTIONAL { ?deploy sda:safetyIntegrityLevel ?safetyIntegrityLevel }
    OPTIONAL { ?deploy sda:determinismClass     ?determinismClass }
    OPTIONAL { ?deploy sda:networkZone          ?networkZone }

    # R2a: Semantic concept coverage (paper Table I)
    # All concepts required by the Skill must be provided by some DataConnector
    # (connector provides a concept when it maps a ProcessVariable described by it)
    FILTER NOT EXISTS {
        ?skill sda:requiresConcept ?requiredConcept .
        FILTER NOT EXISTS {
            ?service sda:hasConnector ?dc .
            ?dc sda:mapsVariable ?pv .
            ?pv sda:describedBy ?requiredConcept .
        }
    }

    # Exclude services with NE 107 Failure status
    FILTER NOT EXISTS {
        ?device  sda:hasNE107Status  :NE107-Failure .
    }
}
ORDER BY DESC(?recall)
LIMIT 1
