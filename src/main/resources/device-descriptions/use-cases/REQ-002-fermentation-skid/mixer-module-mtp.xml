<?xml version="1.0" encoding="UTF-8"?>
<MtpAml xmlns="http://www.example.org/mtp-aml"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <Instance Name="MixerModule-MX101">
        <Service Name="Mixing">
            <Description>Rotary mixing operation for liquid homogenization</Description>
            <Parameter Name="Speed"
                       EngineeringUnit="rpm"
                       NominalRangeMin="0"
                       NominalRangeMax="1500"
                       DataType="Double" />
            <Parameter Name="Temperature"
                       EngineeringUnit="&#176;C"
                       NominalRangeMin="0"
                       NominalRangeMax="200"
                       DataType="Double" />
        </Service>

        <Service Name="TemperatureControl">
            <Description>Temperature monitoring and control for mixing vessel</Description>
            <Parameter Name="Temperature"
                       EngineeringUnit="&#176;C"
                       NominalRangeMin="0"
                       NominalRangeMax="200"
                       DataType="Double" />
            <Parameter Name="FlowRate"
                       EngineeringUnit="l/min"
                       NominalRangeMin="0"
                       NominalRangeMax="50"
                       DataType="Double" />
        </Service>

        <Communication>
            <OpcUaServer Endpoint="opc.tcp://mixer01:4840"
                         SecurityMode="SignAndEncrypt"
                         SecurityPolicy="Basic256Sha256" />
        </Communication>

        <DataAssembly>
            <OpcUaNode NodeId="ns=2;s=Mixer01.Speed"
                       BrowseName="2:Speed"
                       DisplayName="Speed"
                       DataType="Double" />
            <OpcUaNode NodeId="ns=2;s=Mixer01.Temperature"
                       BrowseName="2:Temperature"
                       DisplayName="Temperature"
                       DataType="Double" />
            <OpcUaNode NodeId="ns=2;s=Mixer01.FlowRate"
                       BrowseName="2:FlowRate"
                       DisplayName="FlowRate"
                       DataType="Double" />
            <OpcUaNode NodeId="ns=2;s=Mixer01.Status"
                       BrowseName="2:Status"
                       DisplayName="Status"
                       DataType="UInt32" />
        </DataAssembly>
    </Instance>

</MtpAml>
