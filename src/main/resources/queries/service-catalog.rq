PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sda:  <http://sda-platform.org/ontology#>

# Service Catalog: extract all services with their full CSS-SDA chain (v2).
# SIL is read from the SafetyClass the deployment context is constrained by;
# network zone is read from the NetworkZone the context is located in.
SELECT ?service ?serviceLabel ?capabilityLabel ?skillLabel
       ?protocol ?accessMode ?securityMode
       ?recall ?latency
       ?connectorLabel
       ?deployLabel ?sil ?determinism ?networkZone
WHERE {
    ?service      a                  sda:Service ;
                 rdfs:label          ?serviceLabel ;
                 sda:reportedRecall  ?recall ;
                 sda:reportedLatency ?latency .

    # Capability chain: Service ← isImplementedBy ← Skill ← realisedBy ← OfferedCapability
    OPTIONAL {
        ?capability  a                  sda:OfferedCapability ;
                     sda:realisedBy     ?skill .
        ?skill       sda:isImplementedBy ?service .
        ?capability  rdfs:label          ?capabilityLabel .
        ?skill       rdfs:label          ?skillLabel .
    }

    # Binding chain: Service → hasBinding → CommunicationBinding
    OPTIONAL {
        ?service     sda:hasBinding    ?binding .
        ?binding     sda:protocol       ?protocol ;
                     sda:accessMode     ?accessMode .
        OPTIONAL { ?binding sda:securityMode ?securityMode }

        # Connector chain: Service → hasConnector → DataConnector
        OPTIONAL {
            ?service   sda:hasConnector  ?connector .
            ?connector rdfs:label          ?connectorLabel .
        }
    }

    # Deployment chain: Service → isDeployedBy → DeploymentContext
    OPTIONAL {
        ?service     sda:isDeployedBy   ?deploy .
        ?deploy      rdfs:label         ?deployLabel .
        OPTIONAL { ?deploy sda:determinismClass ?determinism }
        OPTIONAL {
            ?deploy sda:contextConstrainedBy ?safetyClass .
            ?safetyClass sda:safetyIntegrityLevel ?sil
        }
        OPTIONAL {
            ?deploy sda:locatedInZone ?zone .
            ?zone rdfs:label ?networkZone
        }
    }
}
ORDER BY ?serviceLabel
