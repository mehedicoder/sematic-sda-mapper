{
  "title": "SDA Mapper — Pipeline Observability",
  "uid": "sda-mapper-pipeline",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Pipeline runs per outcome",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(sda_pipeline_runs_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Match hit vs no-hit",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (result) (rate(sda_pipeline_match_result_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Stage duration (p95)",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "max by (stage) (sda_pipeline_stage_duration_seconds{quantile=\"0.95\"})",
          "legendFormat": "{{stage}} p95"
        }
      ]
    },
    {
      "id": 4,
      "title": "SPARQL query latency (p95) and result volume",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "max by (query) (sda_sparql_query_seconds{quantile=\"0.95\"})",
          "legendFormat": "{{query}} p95"
        },
        {
          "expr": "sum by (query) (rate(sda_sparql_results_total[5m]))",
          "legendFormat": "{{query}} results/s"
        }
      ]
    },
    {
      "id": 5,
      "title": "Run total by path",
      "type": "stat",
      "gridPos": { "x": 12, "y": 8, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(sda_pipeline_runs_total)",
          "legendFormat": "total runs"
        }
      ]
    },
    {
      "id": 6,
      "title": "Failure rate",
      "type": "stat",
      "gridPos": { "x": 18, "y": 8, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "100 * sum(rate(sda_pipeline_runs_total{outcome=\"failure\"}[15m])) / clamp_min(sum(rate(sda_pipeline_runs_total[15m])), 0.001)",
          "legendFormat": "failure %"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  }
}
