<?xml version="1.0" encoding="UTF-8"?>
<MtpAml xmlns="http://www.example.org/mtp-aml"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <Instance Name="PumpModule-FT101">
        <Service Name="Pumping">
            <Description>Primary pumping operation for liquid transport with flow monitoring</Description>
            <Parameter Name="FlowRate"
                       FunctionClass="FlowControl"
                       EngineeringUnit="l/min"
                       NominalRangeMin="0"
                       NominalRangeMax="100"
                       DataType="Double" />
            <Parameter Name="Pressure"
                       FunctionClass="PressureControl"
                       EngineeringUnit="bar"
                       NominalRangeMin="0.5"
                       NominalRangeMax="10.0"
                       DataType="Double" />
            <Parameter Name="Temperature"
                       FunctionClass="TemperatureControl"
                       EngineeringUnit="&#176;C"
                       NominalRangeMin="-40"
                       NominalRangeMax="150"
                       DataType="Double" />
        </Service>

        <Service Name="FlowMonitoring">
            <Description>Continuous flow rate monitoring with NE 107 diagnostics</Description>
            <Parameter Name="FlowRate"
                       FunctionClass="FlowControl"
                       EngineeringUnit="l/min"
                       NominalRangeMin="0"
                       NominalRangeMax="100"
                       DataType="Double" />
            <Parameter Name="Status"
                       EngineeringUnit=""
                       NominalRangeMin=""
                       NominalRangeMax=""
                       DataType="UInt32" />
        </Service>

        <Communication>
            <OpcUaServer Endpoint="opc.tcp://pump01:4840"
                         SecurityMode="SignAndEncrypt"
                         SecurityPolicy="Basic256Sha256" />
        </Communication>

        <DataAssembly>
            <OpcUaNode NodeId="ns=2;s=Pump01.FlowRate"
                       BrowseName="2:FlowRate"
                       DisplayName="FlowRate"
                       DataType="Double" />
            <OpcUaNode NodeId="ns=2;s=Pump01.Pressure"
                       BrowseName="2:Pressure"
                       DisplayName="Pressure"
                       DataType="Double" />
            <OpcUaNode NodeId="ns=2;s=Pump01.Temperature"
                       BrowseName="2:Temperature"
                       DisplayName="Temperature"
                       DataType="Double" />
            <OpcUaNode NodeId="ns=2;s=Pump01.Status"
                       BrowseName="2:Status"
                       DisplayName="Status"
                       DataType="UInt32" />
        </DataAssembly>
    </Instance>

</MtpAml>
