:securityLevel a owl:DatatypeProperty ;
    rdfs:label "securityLevel"^^xsd:string ;
    rdfs:comment "Used as: CommunicationBinding → xsd:integer (paper Example B: SecurityLevel)"^^xsd:string ;
    rdfs:domain :CommunicationBinding ;
    rdfs:range xsd:integer .

