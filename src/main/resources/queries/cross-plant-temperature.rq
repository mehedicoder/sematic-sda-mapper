PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sda:  <http://sda-platform.org/ontology#>

# Cross-plant query: find all temperature-related services across plants.
# A service counts as temperature-related when its own label mentions
# temperature or when one of its DataConnectors maps a ProcessVariable whose
# label mentions temperature (the v2 equivalent of the former
# belongsToSite-based traversal: assets are linked through ProcessVariables
# described by temperature concepts).
SELECT DISTINCT ?service ?label ?protocol ?recall ?latency ?pv ?pvLabel
WHERE {
    ?service a sda:Service ;
             rdfs:label ?label ;
             sda:reportedRecall ?recall ;
             sda:reportedLatency ?latency ;
             sda:hasBinding ?binding ;
             sda:hasConnector ?connector .

    ?binding sda:protocol ?protocol .

    ?connector sda:mapsVariable ?pv .
    ?pv rdfs:label ?pvLabel .

    FILTER (
        CONTAINS(LCASE(?label), "temperature") ||
        CONTAINS(LCASE(?pvLabel), "temperature")
    )
}
ORDER BY DESC(?recall)
